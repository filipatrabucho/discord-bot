# Token do bot / Bot token (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal → General Information)
CLIENT_ID=
# Opcional: ID de um servidor de testes para registar comandos instantaneamente
# Optional: test server ID to register commands instantly (otherwise global, may take up to 1h)
DEV_GUILD_ID=
# Língua por defeito / default language: pt | en
DEFAULT_LANG=pt
# Ativar pesquisa no YouTube para música / enable YouTube music search (true|false)
ENABLE_YOUTUBE=true
# Caminho da base de dados SQLite / SQLite database path
DB_PATH=data/bot.db
